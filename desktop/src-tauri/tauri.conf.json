{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIPoint Share",
  "version": "1.0.0",
  "identifier": "online.aipoint.share",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AIPoint Share",
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Soubick Das",
    "shortDescription": "AIPoint Share — device to device file transfer",
    "longDescription": "Open mesh file sharing between your devices. Same UI as share.aipoint.online plus a LAN fast path.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
