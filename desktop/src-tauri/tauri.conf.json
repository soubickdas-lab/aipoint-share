{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dukto",
  "version": "1.1.0",
  "identifier": "online.aipoint.share",
  "build": {
    "frontendDist": "../../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dukto",
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Soubick Das",
    "shortDescription": "Dukto — device to device file transfer",
    "longDescription": "Open mesh file sharing between your devices. Same UI as share.aipoint.online plus a LAN fast path.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxMTc1MDU1RUJGNkZFMDcKUldRSC92YnJWVkFYc1FyRXNxTVFCWDJXYkpwQ0lqQ0loUGh5dE03bnhieURlcmNHcWxpdWpHRG0K",
      "endpoints": [
        "https://github.com/soubickdas-lab/aipoint-share/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
