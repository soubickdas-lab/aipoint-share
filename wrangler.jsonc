{
  "name": "aipoint-share",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "ShareRoom" },
      { "name": "PIPE", "class_name": "RelayPipe" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ShareRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RelayPipe"] }
  ],
  "routes": [
    { "pattern": "dukto.aipoint.online", "custom_domain": true },
    { "pattern": "share.aipoint.online", "custom_domain": true }
  ]
}
