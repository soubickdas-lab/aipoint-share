{
  "name": "aipoint-share",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "assets": { "directory": "public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "ShareRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShareRoom"] }],
  "routes": [{ "pattern": "share.aipoint.online", "custom_domain": true }]
}
